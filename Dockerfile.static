ARG NODE_VERSION=24.9
FROM node:${NODE_VERSION}-alpine AS build
WORKDIR /app
RUN apk add --no-cache git && corepack enable && corepack prepare pnpm@10.34.5 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
RUN --mount=type=cache,id=pokerogue-pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG BUILD_MODE=development
ENV CI=true NODE_OPTIONS=--max-old-space-size=6144
RUN pnpm exec vite build --mode "$BUILD_MODE" --config vite.container.config.ts \
    && node container/asset-manifest.mjs

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime
USER root
RUN apk add --no-cache jq
COPY container/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 container/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build --chown=101:101 /app/dist /usr/share/nginx/html
USER 101
ARG VITE_APP_TITLE="PokéRogue (Garrix)"
ENV VITE_APP_TITLE=${VITE_APP_TITLE} \
    VITE_SERVER_URL=/api VITE_BYPASS_LOGIN=0 VITE_BYPASS_TUTORIAL=0 \
    VITE_DISCORD_CLIENT_ID="" VITE_GOOGLE_CLIENT_ID=""
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=6 \
    CMD wget -q -O /dev/null http://127.0.0.1:8000/healthz || exit 1
